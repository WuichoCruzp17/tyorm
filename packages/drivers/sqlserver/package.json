{
  "name": "@tyorm/sqlserver",
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@tyorm/core": "workspace:*",
    "mssql": "12.8.1"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.6",
    "vite": "^7.3.8"
  }
}
