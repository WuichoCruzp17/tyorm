{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "lib": [
      "ES2022",
      "ESNext.Decorators"
    ],
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
