{
    "name": "@tyorm/batch-csv",
    "version": "0.1.0",
    "description": "High-performance CSV ingestion engine for TyORM",
    "main": "index.js",
    "types": "index.d.ts",
    "scripts": {
        "build": "napi build --platform --release",
        "build:debug": "napi build --platform",
        "test": "pnpm run test:rust && pnpm run test:integration",
        "test:rust": "cargo test",
        "test:integration": "vitest run",
        "typecheck": "cargo check",
        "lint": "cargo clippy --all-targets -- -D warnings",
        "format": "cargo fmt",
        "format:check": "cargo fmt --check"
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.11.1",
        "vitest": "^4.1.12"
    }
}
